<Window x:Class="AguasGestionCR.ReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AguasGestionCR"
        mc:Ignorable="d"
        Title="ReportView" Height="654" Width="1059">
    <Window.Resources>
        <!-- Estilo general para Cajas de Texto (TextBox) -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,8,8,8"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5,8,5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo de Tarjeta -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A2540">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Formulario de Reporte de Avería" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL / FORMULARIO -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título Interno -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Ingrese los datos de la incidencia" FontSize="18" FontWeight="Bold" Foreground="#0A2540"/>
                        <TextBlock Text="Complete la información lo más detallada posible para orientar a la cuadrilla de reparación." 
                                   Foreground="#666666" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- FILA 1: NISE / Número de Abonado y Tipo de Avería -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Número de NISE / Cuenta -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Número de Medidor*" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNise" Style="{StaticResource ModernTextBox}" ToolTip="Ej: 1029384"/>
                        </StackPanel>

                        <!-- Tipo de Avería -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tipo de Avería *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbTipoAveria" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                <ComboBoxItem Content="Fuga en tubería / Acera"/>
                                <ComboBoxItem Content="Falta de suministro de agua"/>
                                <ComboBoxItem Content="Baja presión"/>
                                <ComboBoxItem Content="Fuga en el medidor"/>
                                <ComboBoxItem Content="Agua con turbidez / Calidad"/>
                                <ComboBoxItem Content="Otro problema"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- FILA 2: Teléfono de Contacto y Sector / Barrio -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Teléfono de Contacto *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtTelefono" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sector / Comunidad *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtSector" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- FILA 3: Dirección Exacta -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="Dirección Exacta *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDireccion" Style="{StaticResource ModernTextBox}" Height="40" 
                                 ToolTip="Puntos de referencia, metros de la iglesia, escuela, etc."/>
                    </StackPanel>

                    <!-- FILA 4: Descripción del Problema -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <TextBlock Text="Descripción de la Avería *" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDescripcion" AcceptsReturn="True" TextWrapping="Wrap" 
                                 Height="90" FontSize="13" Padding="8" BorderBrush="#CCCCCC" 
                                 VerticalContentAlignment="Top" Background="#FAFAFA"/>
                    </StackPanel>

                    <!-- BOTONES DE ACCIÓN -->
                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="* Campos obligatorios" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>

                        <!-- Botón Cancelar/Regresar -->
                        <Button Grid.Column="1" Content="Cancelar" Width="110" Height="40" Margin="0,0,10,0" 
                                Background="#E0E0E0" Foreground="#333333" FontWeight="SemiBold" 
                                BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>

                        <!-- Botón Enviar Reporte -->
                        <Button Grid.Column="2" Content="Enviar Reporte" Width="140" Height="40" 
                                Background="#C0392B" Foreground="White" FontWeight="Bold" 
                                BorderThickness="0" Cursor="Hand" Click="BtnEnviar_Click"/>
                    </Grid>

                </Grid>
            </Border>
        </ScrollViewer>

        <!-- PIE DE PÁGINA -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E9F2" BorderThickness="0,1,0,0">
            <TextBlock Text="© 2026 Sistema de Gestión del Acueducto" Foreground="#888888" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
        </Border>
    </Grid>
</Window>
