<Window x:Class="AguasGestionCR.ProductoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto"
        Width="920"
        Height="735"
        MinWidth="820"
        MinHeight="680"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/WaterTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="78"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo"
                               Text="Registrar producto"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="TxtSubtitulo"
                               Text="Ingrese la información del producto que formará parte del inventario."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource SkyBrush}"
                        CornerRadius="22"
                        Width="44"
                        Height="44">
                    <TextBlock Text="▣"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="26,20,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mensaje informativo -->
                <Border Grid.Row="0"
                        Background="#EDF6FF"
                        BorderBrush="#C8E2FB"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14"
                        Margin="0,0,0,17">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26"
                                CornerRadius="13"
                                Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="i"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="Los campos marcados con * son obligatorios. El código debe ser único y las cantidades no pueden ser negativas."
                                   Foreground="#245A86"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Formulario principal -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Información del producto"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,16"/>

                        <!-- Código y nombre -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="1.45*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Código del producto *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCodigo"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         MaxLength="50"
                                         CharacterCasing="Upper"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nombre *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtNombre"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         MaxLength="100"/>
                            </StackPanel>
                        </Grid>

                        <!-- Categoría y unidad -->
                        <Grid Grid.Row="2" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Categoría *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbCategoria"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          IsEditable="False"
                                IsTextSearchEnabled="True"
                                          MaxDropDownHeight="220"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unidad *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbUnidad"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          IsEditable="False"
                                          IsTextSearchEnabled="True"
                                          MaxDropDownHeight="220"/>
                            </StackPanel>
                        </Grid>

                        <!-- Cantidades, fecha y estado -->
                        <Grid Grid.Row="3" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCantidad"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="0,00"
                                         TextChanged="Cantidad_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cantidad mínima *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtCantidadMinima"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="20,00"
                                         TextChanged="Cantidad_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Fecha de ingreso *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker x:Name="DtpFechaIngreso"
                                            Style="{StaticResource ModernDatePickerStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Estado *"
                                           Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbEstado"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <ComboBoxItem Content="Activo" IsSelected="True"/>
                                    <ComboBoxItem Content="Inactivo"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Descripción -->
                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Descripción"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtDescripcion"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Height="94"
                                     MaxLength="2000"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Vista previa del stock -->
                <Border x:Name="BordeEstadoStock"
                        Grid.Row="2"
                        Background="{StaticResource SuccessSoftBrush}"
                        BorderBrush="#BEE5CC"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14"
                        Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtIconoStock"
                                   Text="✓"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtTituloStock"
                                       Text="Stock disponible"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                            <TextBlock x:Name="TxtDetalleStock"
                                       Text="La cantidad se encuentra por encima del mínimo establecido."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtResumenStock"
                                   Grid.Column="2"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Mensaje de validación -->
                <Border x:Name="BordeError"
                        Grid.Row="3"
                        Visibility="Collapsed"
                        Background="{StaticResource DangerSoftBrush}"
                        BorderBrush="#F1BABA"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="13"
                        Margin="0,12,0,0">
                    <TextBlock x:Name="TxtError"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               FontSize="12"/>
                </Border>

                <TextBlock Grid.Row="4"
                           Text="Nota: inactivar un producto conserva su información y permite reactivarlo posteriormente."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           Margin="2,12,0,0"/>
            </Grid>
        </ScrollViewer>

        <!-- Acciones -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <Grid Margin="26,0">
                <TextBlock Text="Los datos se guardarán en AcueductoDB."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Limpiar"
                            Style="{StaticResource NeutralButtonStyle}"
                            MinWidth="100"
                            Click="BtnLimpiar_Click"/>
                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="100"
                            Margin="9,0,0,0"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnGuardar"
                            Content="Guardar producto"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="145"
                            Margin="9,0,0,0"
                            Click="BtnGuardar_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
