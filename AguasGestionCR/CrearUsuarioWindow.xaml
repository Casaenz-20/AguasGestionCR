<Window x:Class="AcueductoApp.Views.CrearUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Usuario" Height="700" Width="820"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Window.Resources>
        <!-- Estilo base para cajas de texto -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo base para contraseña -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo base para ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <!-- Tarjeta Principal -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="25">
                <StackPanel>

                    <!-- Encabezado con Botón Regresar y Título -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Width="36" Height="36" Background="Transparent" BorderThickness="1" BorderBrush="#CBD5E1" Margin="0,0,15,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="M20,11H7.83l5.59-5.59L12,4l-8,8l8,8l1.41-1.41L7.83,13H20V11z" Fill="#1E293B"/>
                                        </Viewbox>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Crear usuario" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Registre un nuevo usuario en el sistema." Foreground="#64748B" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Cuadro Informativo Blue Callout -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                                <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-6h2V17z M13,9h-2V7h2V9z" Fill="#2563EB"/>
                            </Viewbox>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="El usuario solo puede crearse si el número de medidor está asociado a la identificación." 
                                           FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap" FontSize="13"/>
                                <TextBlock Text="Verifique que la información sea correcta antes de guardar." 
                                           Foreground="#1E40AF" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Formulario Grid de 2 Columnas -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fila 0: Nombre completo e Identificación -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Nombre completo *" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBox x:Name="txtNombre" Tag="Ingrese el nombre completo del usuario"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M12,6c1.66,0,3,1.34,3,3s-1.34,3-3,3s-3-1.34-3-3S10.34,6,12,6z M18,18H6v-1c0-2,4-3.1,6-3.1s6,1.1,6,3.1V18z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Identificación *" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBox x:Name="txtIdentificacion"/>
                        </StackPanel>

                        <!-- Fila 1: Número de medidor y Correo electrónico -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M12,2.69l5.66,5.66a8,8,0,1,1-11.31,0z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Número de medidor *" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBox x:Name="txtMedidor"/>
                            <TextBlock Text="Debe estar asociado a la identificación." Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,8l-8,5L4,8V6l8,5l8-5V8z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Correo electrónico" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBox x:Name="txtCorreo"/>
                        </StackPanel>

                        <!-- Fila 2: Nombre de usuario y Rol -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Nombre de usuario *" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBox x:Name="txtUsuario"/>
                            <TextBlock Text="Se usará para iniciar sesión en el sistema." Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Rol del usuario *" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <ComboBox x:Name="cmbRol" SelectedIndex="0">
                                <ComboBoxItem Content="Cliente"/>
                                <ComboBoxItem Content="Administrador"/>
                            </ComboBox>
                            <TextBlock Text="Seleccione el tipo de acceso." Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Fila 3: Contraseña y Confirmar Contraseña -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,8.9,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S13.1,17,12,17z M15.1,8H8.9V6c0-1.71,1.39-3.1,3.1-3.1c1.71,0,3.1,1.39,3.1,3.1V8z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Contraseña *" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <PasswordBox x:Name="txtClave"/>
                            <TextBlock Text="Debe tener al menos 8 caracteres, incluyendo número y letra." Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Data="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,8.9,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S13.1,17,12,17z M15.1,8H8.9V6c0-1.71,1.39-3.1,3.1-3.1c1.71,0,3.1,1.39,3.1,3.1V8z" Fill="#64748B"/>
                                </Viewbox>
                                <TextBlock Text="Confirmar contraseña *" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <PasswordBox x:Name="txtConfirmarClave"/>
                            <TextBlock Text="Las contraseñas deben coincidir." Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Acciones Inferiores (Botones) -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <!-- Botón Cancelar -->
                            <Button x:Name="btnCancelar" Width="110" Height="38" Margin="0,0,12,0" 
                                    Click="btnCancelar_Click" Background="White" Foreground="#334155" 
                                    BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                    <Path Data="M19,6.41L17.59,5,12,10.59,6.41,5,5,6.41,10.59,12,5,17.59,6.41,19,12,13.41,17.59,19,19,17.59,13.41,12z" Fill="#334155"/>
                                                </Viewbox>
                                                <TextBlock Text="Cancelar" FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Botón Guardar -->
                            <Button x:Name="btnGuardar" Width="110" Height="38" 
                                    Click="btnGuardar_Click" Background="#2563EB" Foreground="White" 
                                    FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                    <Path Data="M17,3H5C3.89,3,3,3.9,3,5v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V7L17,3z M12,19c-1.66,0-3-1.34-3-3s1.34-3,3-3s3,1.34,3,3S13.66,19,12,19z M15,9H5V5h10V9z" Fill="White"/>
                                                </Viewbox>
                                                <TextBlock Text="Guardar" FontSize="13" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>