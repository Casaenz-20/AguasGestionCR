<Window x:Class="AguasGestionCR.Views.OlvidarContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restablecer Contraseña" Height="500" Width="420"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Recuperar Contraseña" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock Text="Sistema de Gestión AguasGestionCR" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <StackPanel x:Name="panelPaso1" Visibility="Visible">
                <TextBlock Text="Ingrese su correo electrónico registrado:" FontSize="13" Foreground="#334155" Margin="0,0,0,8"/>
                <TextBox x:Name="txtCorreo" Height="38" Padding="8" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,15"/>

                <Button x:Name="btnEnviarCodigo" Content="Enviar Código de Verificación" Height="40" Background="#2563EB" Foreground="White" 
                    FontSize="14" FontWeight="Bold" Click="btnEnviarCodigo_Click"/>
            </StackPanel>

            <StackPanel x:Name="panelPaso2" Visibility="Collapsed">
                <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                    <TextBlock Text="Hemos enviado un código de 6 dígitos a tu correo Gmail." 
                           FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="Código de verificación:" FontSize="13" Foreground="#334155" Margin="0,0,0,8"/>
                <TextBox x:Name="txtCodigoIngresado" Height="40" Padding="5" VerticalContentAlignment="Center" 
                     FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" MaxLength="6" Margin="0,0,0,15"/>

                <Button x:Name="btnVerificarCodigo" Content="Verificar Código" Height="40" Background="#2563EB" Foreground="White" 
                    FontSize="14" FontWeight="Bold" Click="btnVerificarCodigo_Click"/>
            </StackPanel>

            <StackPanel x:Name="panelPaso3" Visibility="Collapsed">
                <TextBlock Text="Nueva Contraseña *" FontSize="13" Foreground="#334155" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtNuevaClave" Height="38" Padding="8" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Confirmar Nueva Contraseña *" FontSize="13" Foreground="#334155" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtConfirmarClave" Height="38" Padding="8" VerticalContentAlignment="Center" Margin="0,0,0,18"/>

                <Button x:Name="btnCambiarClave" Content="Guardar Nueva Contraseña" Height="40" Background="#16A34A" Foreground="White" 
                    FontSize="14" FontWeight="Bold" Click="btnCambiarClave_Click"/>
            </StackPanel>

            <Button Content="Cancelar / Volver" Margin="0,20,0,0" Background="Transparent" 
                BorderThickness="0" Foreground="#64748B" Cursor="Hand" Click="btnCancelar_Click"/>

        </StackPanel>
    </Grid>
</Window>