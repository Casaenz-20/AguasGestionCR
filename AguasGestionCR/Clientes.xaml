<Window x:Class="AguasGestionCR.Clientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AguasGestionCR"
        mc:Ignorable="d"
        Title="Clientes"
        Height="689"
        Width="800"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <!-- Contenedor principal con fondo semitransparente -->
    <Grid Margin="0,29,0,0" Height="660" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="91*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="638*"/>
            <ColumnDefinition Width="151*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>

        <!-- Tarjeta Flotante Principal -->
        <Border Background="White" CornerRadius="12" Width="687" Height="574" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="54,10,0,0" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. CABECERA -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono simulado de usuarios -->
                        <TextBlock Text="👥" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Registrar / Editar Cliente" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Botón Cerrar (X) -->
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30" 
                            Background="Transparent" BorderBrush="Transparent" Foreground="#64748B" FontSize="16" Cursor="Hand"/>
                </Grid>

                <!-- 2. CONTENIDO CENTRAL (Formulario de una sola columna ajustado) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Información del cliente" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <!-- Nombre completo -->
                        <TextBlock Text="Nombre completo" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Height="36" Padding="8,6" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"/>

                        <!-- Identificación y Medidor -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Identificación" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Height="36" Padding="8,6" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Número de medidor" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Height="36" Padding="8,6" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dirección -->
                        <TextBlock Text="Dirección" FontSize="12" Foreground="#475569" Margin="0,12,0,4"/>
                        <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,6" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"/>

                        <!-- Teléfono y Correo -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teléfono" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Height="36" Padding="8,6" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Correo electrónico" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Height="36" Padding="8,6" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <!-- Estado -->
                        <TextBlock Text="Estado" FontSize="12" Foreground="#475569" Margin="0,12,0,4"/>
                        <ComboBox Height="36" Padding="8,6" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="#F8FAFC" SelectedIndex="0">
                            <ComboBoxItem Content="Activo"/>
                            <ComboBoxItem Content="Inactivo"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. PIE DE PÁGINA (Botones de acción) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Limpiar" Width="90" Height="36" Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" Foreground="#475569" Cursor="Hand"/>
                    <Button Content="Cancelar" Width="90" Height="36" Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" Foreground="#475569" Cursor="Hand"/>
                    <Button Content="Guardar" Width="100" Height="36" Background="#0284C7" BorderBrush="Transparent" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>