<Window x:Class="AguasGestionCR.ProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Inventario - Acueducto"
        Width="1240"
        Height="700"
        MinWidth="1040"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="White"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/WaterTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Encabezado general -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <TextBlock Text="Sistema de Gestión del Acueducto"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="15"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Border Background="{StaticResource SkyBrush}"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="0,0,14,0">

                        <TextBlock Text="Administrador"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </Border>

                    <TextBlock x:Name="TxtFechaActual"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido desplazable -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="24,20,24,22">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título, navegación y acción principal -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="←  Volver al panel"
                            Style="{StaticResource NeutralButtonStyle}"
                            MinWidth="145"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Click="BtnInicio_Click"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Gestión de Inventario"
                                   Style="{StaticResource PageTitleStyle}"/>

                        <TextBlock Text="Administra los materiales, herramientas y suministros del acueducto."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="＋  Nuevo producto"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="150"
                            Click="BtnNuevo_Click"/>
                </Grid>

                <!-- Indicadores de inventario -->
                <UniformGrid Grid.Row="1"
                             Columns="4"
                             Margin="-6,0,-6,18">

                    <!-- Total -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="6">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="10"
                                    Background="#E6F1FF">

                                <TextBlock Text="▦"
                                           FontSize="21"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">

                                <TextBlock Text="Total de productos"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"/>

                                <TextBlock x:Name="TxtTotalProductos"
                                           Text="0"
                                           Foreground="{StaticResource TextBrush}"
                                           FontWeight="Bold"
                                           FontSize="24"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Activos -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="6">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="10"
                                    Background="{StaticResource SuccessSoftBrush}">

                                <TextBlock Text="✓"
                                           FontSize="21"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">

                                <TextBlock Text="Productos activos"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"/>

                                <TextBlock x:Name="TxtProductosActivos"
                                           Text="0"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontWeight="Bold"
                                           FontSize="24"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stock bajo -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="6">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="10"
                                    Background="{StaticResource WarningSoftBrush}">

                                <TextBlock Text="!"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">

                                <TextBlock Text="Con stock bajo"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"/>

                                <TextBlock x:Name="TxtStockBajo"
                                           Text="0"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontWeight="Bold"
                                           FontSize="24"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inactivos -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Margin="6">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="10"
                                    Background="{StaticResource DangerSoftBrush}">

                                <TextBlock Text="×"
                                           FontSize="24"
                                           Foreground="{StaticResource DangerBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">

                                <TextBlock Text="Productos inactivos"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"/>

                                <TextBlock x:Name="TxtProductosInactivos"
                                           Text="0"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontWeight="Bold"
                                           FontSize="24"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Búsqueda y filtros -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Búsqueda y filtros"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,13"/>

                        <Grid Grid.Row="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Código o nombre -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0">

                                <TextBlock Text="Código o nombre"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="TxtBusqueda"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ToolTip="Busque por código o nombre del producto"
                                         KeyDown="TxtBusqueda_KeyDown"/>
                            </StackPanel>

                            <!-- Categoría -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="2">

                                <TextBlock Text="Categoría"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="CmbCategoria"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>

                            <!-- Estado -->
                            <StackPanel Grid.Row="0"
                                        Grid.Column="4">

                                <TextBlock Text="Estado"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="CmbEstado"
                                          Style="{StaticResource ModernComboBoxStyle}">

                                    <ComboBoxItem Content="Todos"
                                                  IsSelected="True"/>

                                    <ComboBoxItem Content="Activo"/>

                                    <ComboBoxItem Content="Inactivo"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Solo stock bajo -->
                            <CheckBox x:Name="ChkSoloStockBajo"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Content="Mostrar únicamente productos activos con stock bajo"
                                        Foreground="{StaticResource TextBrush}"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Margin="0,15,0,0"
                                        Checked="ChkSoloStockBajo_Changed"
                                        Unchecked="ChkSoloStockBajo_Changed"/>

                            <!-- Botones de consulta -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0">

                                <Button Content="Buscar"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="95"
                                        Click="BtnBuscar_Click"/>

                                <Button Content="Limpiar"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        MinWidth="95"
                                        Margin="8,0,0,0"
                                        Click="BtnLimpiarFiltros_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Listado -->
                <Border Grid.Row="3"
                        Style="{StaticResource CardBorderStyle}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Encabezado del listado -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,12">

                            <StackPanel>
                                <TextBlock Text="Productos del inventario"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Utilice la búsqueda o los filtros para consultar los productos del inventario."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                <Button x:Name="BtnEditar"
                                        Content="Editar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="90"
                                        IsEnabled="False"
                                        Click="BtnEditar_Click"/>

                                <Button x:Name="BtnCambiarEstado"
                                        Content="Inactivar"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinWidth="100"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="BtnCambiarEstado_Click"/>

                                <Button Content="Actualizar"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        MinWidth="95"
                                        Margin="8,0,0,0"
                                        Click="BtnActualizar_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tabla -->
                        <DataGrid x:Name="DgProductos"
                                  Grid.Row="1"
                                  Style="{StaticResource ProductDataGridStyle}"
                                  MinHeight="280"
                                  MaxHeight="370"
                                  IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="DgProductos_SelectionChanged"
                                  MouseDoubleClick="DgProductos_MouseDoubleClick">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">

                                    <Setter Property="Background"
                                            Value="White"/>

                                    <Setter Property="Foreground"
                                            Value="{StaticResource TextBrush}"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding StockBajo}"
                                                     Value="True">

                                            <Setter Property="Background"
                                                    Value="#FFF9ED"/>
                                        </DataTrigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#DCEEFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding CodigoProducto}"
                                                    Width="125"/>

                                <DataGridTextColumn Header="Producto"
                                                    Binding="{Binding Nombre}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Categoría"
                                                    Binding="{Binding Categoria}"
                                                    Width="1.45*"/>

                                <DataGridTextColumn Header="Cantidad"
                                                    Binding="{Binding Cantidad,
                                                              StringFormat={}{0:N2}}"
                                                    Width="85"/>

                                <DataGridTextColumn Header="Mínimo"
                                                    Binding="{Binding CantidadMinima,
                                                              StringFormat={}{0:N2}}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Unidad"
                                                    Binding="{Binding Unidad}"
                                                    Width="105"/>

                                <!-- Disponibilidad -->
                                <DataGridTemplateColumn Header="Disponibilidad"
                                                        Width="115">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Border x:Name="BadgeStock"
                                                    Background="{StaticResource SuccessSoftBrush}"
                                                    CornerRadius="12"
                                                    Padding="9,4"
                                                    HorizontalAlignment="Left">

                                                <TextBlock x:Name="TxtBadgeStock"
                                                           Text="{Binding EstadoStock}"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <DataTemplate.Triggers>

                                                <DataTrigger Binding="{Binding StockBajo}"
                                                             Value="True">

                                                    <Setter TargetName="BadgeStock"
                                                            Property="Background"
                                                            Value="{StaticResource WarningSoftBrush}"/>

                                                    <Setter TargetName="TxtBadgeStock"
                                                            Property="Foreground"
                                                            Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Estado -->
                                <DataGridTemplateColumn Header="Estado"
                                                        Width="90">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <Border x:Name="BadgeEstado"
                                                    Background="{StaticResource SuccessSoftBrush}"
                                                    CornerRadius="12"
                                                    Padding="9,4"
                                                    HorizontalAlignment="Left">

                                                <TextBlock x:Name="TxtBadgeEstado"
                                                           Text="{Binding Estado}"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <DataTemplate.Triggers>

                                                <DataTrigger Binding="{Binding Estado}"
                                                             Value="Inactivo">

                                                    <Setter TargetName="BadgeEstado"
                                                            Property="Background"
                                                            Value="{StaticResource DangerSoftBrush}"/>

                                                    <Setter TargetName="TxtBadgeEstado"
                                                            Property="Foreground"
                                                            Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pie del listado -->
                        <Grid Grid.Row="2"
                              Margin="0,12,0,0">

                            <TextBlock x:Name="TxtResultadoListado"
                                       Text="Ingrese un criterio para consultar productos."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Seleccione una fila o utilice doble clic para editar"
                                       HorizontalAlignment="Right"
                                       Foreground="#91A0AE"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Pie general -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">

            <TextBlock Text="© 2026 Sistema de Gestión del Acueducto"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"/>
        </Border>
    </Grid>
</Window>